partial alphanumeric_keys
xkb_symbols "capslock_arrows" {
    key <CAPS> { [ ISO_Level3_Shift, ISO_Level3_Shift, ISO_Level3_Shift, ISO_Level3_Shift ] };
    key <AC05> { [ g,          G,          Home,        Home        ] };
    key <AC06> { [ h,          H,          Left,        Left        ] };
    key <AC07> { [ j,          J,          Down,        Down        ] };
    key <AC08> { [ k,          K,          Up,          Up          ] };
    key <AC09> { [ l,          L,          Right,       Right       ] };
    key <AC10> { [ semicolon,  colon,      End,         End         ] };
};
